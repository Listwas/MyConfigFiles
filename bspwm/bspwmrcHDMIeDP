#! /bin/sh

# start sxhkd with bspwm
pgrep -x sxhkd >/dev/null || sxhkd &

xrandr --output DP-1-0 --off
xrandr --output DP-1-1 --off
xrandr --output HDMI-1 --mode 1920x1080 --primary --rate 60
xrandr --output eDP-1 --mode 1920x1080 --left-of HDMI-1 --rate 144

bspc monitor eDP-1 -d 6
bspc monitor HDMI-1 -d 1 2 3 4 5
bspc wm -O HDMI-1 eDP-1

# bspwm settings
bspc config border_width            1
bspc config window_gap              0
bspc config focused_border_color    "#690c6f"
bspc config split_ratio             0.52
bspc config borderless_monocle      true
bspc config gapless_monocle         true
bspc config focus_follows_pointer   true
bspc config bottom_padding          10


# reset vivaldi behavior
bspc rule -a Vivaldi-stable state=tiled sticky=off

picom --config $HOME/.config/picom/picom.conf &
dunst &
polybar main &
flameshot &
nitrogen --restore &
